# GitLab: entweder die beiden Einzelwerte für eine Instanz ODER
# GITLAB_CONNECTIONS für mehrere Projekte/Instanzen konfigurieren.
# GITLAB_HOST=https://gitlab.example.com
# GITLAB_TOKEN=glpat-...

# Ein JSON-Array auf EINER Zeile. projects sind Pfade relativ zu host;
# ohne projects gilt die Verbindung für alle Projekte dieses Hosts.
GITLAB_CONNECTIONS='[{"host":"https://gitlab.example.com","token":"glpat-token-a","projects":["group/project-a","group/project-b"]},{"host":"https://gitlab.example.com","token":"glpat-token-b","projects":["other-group/project-c"]}]'
# Für eine zweite GitLab-Instanz einen weiteren Eintrag mit eigenem host ergänzen.

# Muss mit dem Secret Token des GitLab-Webhooks übereinstimmen
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Automatisierte MRs werden vor dem Review übersprungen: GitLab-Bots sowie
# Renovate/Dependabot-Autoren und Branches mit renovate/ oder dependabot/.
# Zusätzliche Automatisierungsaccounts (exakte Benutzernamen, kommagetrennt):
# GITLAB_IGNORED_MR_AUTHORS=svc-dependencies,company-renovate
# Zusätzliche Branch-Präfixe (Groß-/Kleinschreibung beachten, kommagetrennt):
# GITLAB_IGNORED_SOURCE_BRANCH_PREFIXES=automation/,dependency-updates/

# Lernfreundliche Erklärung bestätigter ADR-Verstöße für ausgewählte MR-Autoren.
# GitLab-Profil öffnen: @anna wird als anna eingetragen (OHNE @).
# Usernames verwenden, keine Anzeigenamen oder E-Mail-Adressen; kommagetrennt.
# Äußere Leerzeichen und Groß-/Kleinschreibung werden ignoriert, leere Einträge übersprungen.
# Zum Aktivieren den leeren Wert unten durch die eigenen Usernames ersetzen, z. B.:
# LEARNING_USERS=anna,mustermann.max,neue-kollegin
# Nicht gesetzt oder leer: deaktiviert. Gilt für neu angelegte Reviews.
# Der ADR-Check bleibt erhalten; Erklärung im bestehenden Verifikationsaufruf.
# Danach Backend neu starten; bei Compose: podman compose up -d --force-recreate app
# Einrichtung und Ablaufdiagramm: README → Lernfreundliche ADR-Erklärungen.
LEARNING_USERS=

# OpenAI-kompatibles LLM-Gateway
LLM_BASE_URL=https://api.openai.com/v1
# Pfad hinter LLM_BASE_URL; für ältere Gateways ggf. /chat/completions setzen.
LLM_CHAT_PATH=/chat/response
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0
# LLM_SEED=42
# Optional: separates Modell für Extraktion/Triage/Dubletten und Verifikation.
# Ohne Angabe verwenden beide LLM_MODEL.
# LLM_FAST_MODEL=your-fast-model
# LLM_VERIFY_MODEL=your-verification-model

# Öffentlich erreichbare App-URL für Links in GitLab-Kommentaren.
# Ohne diesen Wert nutzt die App CALLBACK_BASE_URL aus .env; http://HOST
# ohne Portangabe verwendet Port 80.
PUBLIC_BASE_URL=http://localhost
# Callback-URL bei lokalem Start (npm run dev); Podman Compose verwendet
# für Sandbox-Callbacks separat SANDBOX_CALLBACK_BASE_URL=http://app:5000.
CALLBACK_BASE_URL=http://host.containers.internal:3000

# Podman Compose (optional)
# Host-Port der VM (wird auf den Container-Port 5000 abgebildet).
# Host-Port der VM; hier auf Container-Port 5000 abgebildet
# APP_PORT=80

# Sandbox (optional)
SANDBOX_RUNTIME=podman
SANDBOX_IMAGE=adr-review-agent:latest
SANDBOX_TIMEOUT_SECONDS=1800

# Review-Daten und Agentenlimits (optional)
DATA_DIR=./data
# Regel-Cache: max. 2 MiB / 128 ADRs / 30 Tage; 0 schaltet ihn ab.
# Nutzt data/adr-rule-cache.json, kein zusätzliches Container-Volume.
ADR_RULE_CACHE=1
BUDGET_SEARCH_ROUNDS=8
BUDGET_FILE_READS=5
BUDGET_REFETCHES=2
# Je Diffteil / Integrationspaket / Verifikation; max. Kandidaten je Sammelpaket
LEARNING_BUDGET_SEARCH_ROUNDS=24
LEARNING_BUDGET_FILE_READS=16
LEARNING_MAX_FINDINGS=20
LEARNING_CHUNK_BYTES=32000
LEARNING_CONCURRENCY=3
# Eigenständige Lernreview-Modelle; ADR-Modell-Overrides gelten hier nicht.
# LEARNING_MODEL=your-search-model
# LEARNING_VERIFY_MODEL=your-verification-model
# LEARNING_DEDUP_MODEL=your-deduplication-model
# auto spart die zweite Suche nur bei kleinen, vollständig untersuchten lokalen Änderungen.
# always führt sie für jeden prüfbaren MR aus.
LEARNING_INTEGRATION_MODE=auto
EXTRACTION_CONCURRENCY=3
JUDGING_CONCURRENCY=3
