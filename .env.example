# GitLab: entweder die beiden Einzelwerte für eine Instanz ODER
# GITLAB_CONNECTIONS für mehrere Projekte/Instanzen konfigurieren.
# GITLAB_HOST=https://gitlab.example.com
# GITLAB_TOKEN=glpat-...

# Ein JSON-Array auf EINER Zeile. projects sind Pfade relativ zu host;
# ohne projects gilt die Verbindung für alle Projekte dieses Hosts.
GITLAB_CONNECTIONS='[{"host":"https://gitlab.example.com","token":"glpat-token-a","projects":["group/project-a","group/project-b"]},{"host":"https://gitlab.example.com","token":"glpat-token-b","projects":["other-group/project-c"]}]'
# Für eine zweite GitLab-Instanz einen weiteren Eintrag mit eigenem host ergänzen.

# Muss mit dem Secret Token des GitLab-Webhooks übereinstimmen
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# OpenAI-kompatibles LLM-Gateway
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0
# LLM_SEED=42

# Öffentlich erreichbare App-URL für Links in GitLab-Kommentaren
PUBLIC_BASE_URL=http://localhost
# Callback-URL bei lokalem Start (npm run dev); Podman Compose überschreibt
# diesen Wert intern mit http://app:5000.
CALLBACK_BASE_URL=http://host.containers.internal:3000

# Podman Compose (optional)
# Host-Port der VM (wird auf den Container-Port 5000 abgebildet).
# Host-Port der VM; hier auf Container-Port 5000 abgebildet
# APP_PORT=80

# Sandbox (optional)
SANDBOX_RUNTIME=podman
SANDBOX_IMAGE=adr-review-agent:latest
SANDBOX_TIMEOUT_SECONDS=1800

# Review-Daten und Agentenlimits (optional)
DATA_DIR=./data
BUDGET_SEARCH_ROUNDS=8
BUDGET_FILE_READS=5
BUDGET_REFETCHES=2
LEARNING_BUDGET_SEARCH_ROUNDS=24
LEARNING_BUDGET_FILE_READS=16
LEARNING_MAX_FINDINGS=20
LEARNING_MAX_PATCH_BYTES=200000
EXTRACTION_CONCURRENCY=3
JUDGING_CONCURRENCY=3
