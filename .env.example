# GitLab-Instanz und persönlicher bzw. Projekt-Access-Token
GITLAB_HOST=https://gitlab.example.com
GITLAB_TOKEN=glpat-...

# Muss mit dem Secret Token des GitLab-Webhooks übereinstimmen
GITLAB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# OpenAI-kompatibles LLM-Gateway
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0
# LLM_SEED=42

# Öffentlich erreichbare App-URL für Links in GitLab-Kommentaren
PUBLIC_BASE_URL=http://localhost:3000
# Vom Container erreichbare URL für den Callback
CALLBACK_BASE_URL=http://host.containers.internal:3000

# Sandbox (optional)
SANDBOX_RUNTIME=podman
SANDBOX_IMAGE=adr-review-agent:latest
SANDBOX_TIMEOUT_SECONDS=1800

# Review-Daten und Agentenlimits (optional)
DATA_DIR=./data
BUDGET_SEARCH_ROUNDS=8
BUDGET_FILE_READS=5
BUDGET_REFETCHES=2
EXTRACTION_CONCURRENCY=3
JUDGING_CONCURRENCY=3
